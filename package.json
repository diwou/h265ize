{
  "name": "@diwou/h265ize",
  "version": "0.6.4",
  "mode": "development",
  "packageManager": "npm@11.7.0",
  "description": "Maintained Node.js CLI for batch video transcoding to H.265/HEVC with modern ffmpeg compatibility.",
  "main": "h265ize",
  "scripts": {
    "test": "node --test test.js"
  },
  "bin": {
    "h265ize": "h265ize"
  },
  "directories": {
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/diwou/h265ize.git"
  },
  "keywords": [
    "hevc",
    "h265",
    "ffmpeg",
    "transcoding",
    "video",
    "cli",
    "batch-processing",
    "media",
    "nodejs"
  ],
  "author": "Ayrton Sparling (original project), maintained fork by local repository owner",
  "license": "MIT",
  "bugs": {
    "url": "https://codeberg.org/diwou/h265ize/issues"
  },
  "homepage": "https://codeberg.org/diwou/h265ize",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "colors": "^1.1.2",
    "memorystream": "^0.3.1",
    "strip-ansi": "^3.0.1",
    "yargs": "^18.0.0"
  },
  "eslintConfig": {
    "parserOptions": {
      "ecmaVersion": 6,
      "sourceType": "module"
    },
    "env": {
      "node": true
    },
    "rules": {
      "strict": [
        2,
        "never"
      ]
    }
  }
}
