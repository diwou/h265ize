{
  "name": "@diwou/h265ize",
  "version": "0.6.3",
  "mode": "development",
  "packageManager": "npm@11.7.0",
  "description": "Maintained Node.js CLI for batch video transcoding to H.265/HEVC with modern ffmpeg compatibility.",
  "main": "h265ize",
  "scripts": {
    "postinstall": "patch-package",
    "test": "mocha --reporter spec test.js"
  },
  "bin": {
    "h265ize": "./h265ize"
  },
  "directories": {
    "lib": "lib"
  },
  "repository": {
    "type": "git",
    "url": "git+https://codeberg.org/diwou/h265ize.git"
  },
  "keywords": [
    "hevc",
    "h265",
    "ffmpeg",
    "transcoding",
    "video",
    "cli",
    "batch-processing",
    "media",
    "nodejs"
  ],
  "author": "Ayrton Sparling (original project), maintained fork by local repository owner",
  "license": "MIT",
  "bugs": {
    "url": "https://codeberg.org/diwou/h265ize/issues"
  },
  "homepage": "https://codeberg.org/diwou/h265ize",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "bluebird": "^3.4.6",
    "chokidar": "^5.0.0",
    "colors": "^1.1.2",
    "filesize": "^3.3.0",
    "fluent-ffmpeg": "2.1.2",
    "gpu-info": "0.0.1",
    "hasbin": "^1.2.3",
    "keypress": "^0.2.1",
    "memorystream": "^0.3.1",
    "mime": "^1.3.4",
    "patch-package": "^8.0.1",
    "promise-pauser": "^1.0.0",
    "strip-ansi": "^3.0.1",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "chai": "^3.5.0",
    "mocha": "^11.3.0"
  },
  "eslintConfig": {
    "parserOptions": {
      "ecmaVersion": 6,
      "sourceType": "module"
    },
    "env": {
      "node": true
    },
    "rules": {
      "strict": [
        2,
        "never"
      ]
    }
  }
}
